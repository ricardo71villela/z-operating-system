{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm install --prefix apps/fashion/apps/fashion-partner"
  },
  "deploy": {
    "startCommand": "node apps/fashion/apps/fashion-partner/src/server.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60
  }
}
