# Copy this file to .env and fill in real values from:
# Supabase Dashboard → Project Settings → API
#
# Never commit .env — it is already in .gitignore.
#
# Required by:
# - scripts/test-connectivity.js (Node connectivity check)
# - apps/zfind-web/scripts/build.js (Sprint 1.1+ — injected into the
#   built browser bundle at build time; the build refuses to run
#   without both values set)

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Required by:
# - apps/zfind-web/scripts/generate-seo-pages.js (npm run build:seo-pages)
# Real domain, confirmed 2026-07-28. The generator refuses to run
# without this — never generates a page with a guessed canonical URL.
SITE_BASE_URL=https://zfind.online
