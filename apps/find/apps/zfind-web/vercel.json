{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "B=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^};[ \"$B\" = \"$VERCEL_GIT_COMMIT_SHA\" ]&&exit 1;git cat-file -e \"$B^{commit}\" 2>/dev/null||exit 1;git diff --quiet \"$B\" HEAD -- ':(top)apps/find/apps/zfind-web/**' ':(top)apps/find/package.json' ':(top)package-lock.json'",
  "cleanUrls": true,
  "trailingSlash": false,
  "build": {
    "env": {
      "SUPABASE_URL": "https://dcdggqyazdddrfuzwavw.supabase.co",
      "SUPABASE_ANON_KEY": "sb_publishable_LQqhseuSfNibffNh_cLLGQ_0cVxHQzX",
      "SITE_BASE_URL": "https://zfind.online"
    }
  },
  "buildCommand": "cd ../.. && node apps/zfind-web/scripts/build.js && node apps/zfind-web/scripts/generate-seo-pages.js && node apps/zfind-web/scripts/prepare-vercel-output.js",
  "outputDirectory": "vercel-output",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/estimation",
      "destination": "/api/estimation"
    },
    {
      "source": "/api/alerts",
      "destination": "/api/alerts"
    },
    {
      "source": "/api/prospection-optout",
      "destination": "/api/prospection-optout"
    },
    {
      "source": "/api/reviews",
      "destination": "/api/reviews"
    },
    {
      "source": "/api/cron-daily",
      "destination": "/api/cron-daily"
    },
    {
      "source": "/api/lead-notify",
      "destination": "/api/lead-notify"
    },
    {
      "source": "/api/media-import",
      "destination": "/api/media-import"
    },
    {
      "source": "/api/feed-sync",
      "destination": "/api/feed-sync"
    },
    {
      "source": "/fr/annonce/:path*",
      "destination": "/api/annonce?p=:path*"
    },
    {
      "source": "/fr/property/:id",
      "destination": "/api/annonce?p=:id"
    },
    {
      "source": "/sitemap-annonces.xml",
      "destination": "/api/annonce?sitemap=1"
    },
    {
      "source": "/fr/immobilier/:path*",
      "destination": "/api/immobilier?p=:path*"
    },
    {
      "source": "/sitemap-immobilier.xml",
      "destination": "/api/immobilier?sitemap=1"
    },
    {
      "source": "/fr/prix-immobilier",
      "destination": "/api/prix-immobilier"
    },
    {
      "source": "/fr/prix-immobilier/:path*",
      "destination": "/api/prix-immobilier?p=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "cd ../../../.. && npm ci --workspace=apps/find",
  "functions": {
    "api/estimation.js": {
      "includeFiles": "{public/market-data/**,public/geo/search/**,src/services/estimation.js,src/services/search-filters.js,src/services/listing-quality.js,src/services/place-search.js}",
      "maxDuration": 15
    },
    "api/alerts.js": {
      "includeFiles": "{public/geo/search/**,src/services/search-filters.js,src/services/listing-quality.js,src/services/place-search.js}",
      "maxDuration": 15
    },
    "api/reviews.js": {
      "maxDuration": 15
    },
    "api/lead-notify.js": {
      "maxDuration": 30
    },
    "api/media-import.js": {
      "maxDuration": 60
    },
    "api/feed-sync.js": {
      "includeFiles": "{src/services/listing-import/**,src/services/listing-compliance.js}",
      "maxDuration": 60
    },
    "api/cron-daily.js": {
      "includeFiles": "{public/market-data/**,public/geo/search/**,src/services/estimation.js,src/services/search-filters.js,src/services/listing-quality.js,src/services/place-search.js}",
      "maxDuration": 60
    },
    "api/prix-immobilier.js": {
      "includeFiles": "{public/market-data/fr/**,public/market-data/be/**,public/market-data/lu/**,src/services/seo-page-generator.js,src/services/acquisition-costs.js,src/services/credit-rates.js,src/services/credit-simulator.js}",
      "maxDuration": 15
    },
    "api/immobilier.js": {
      "includeFiles": "{public/market-data/fr/**,src/services/seo-page-generator.js,src/services/acquisition-costs.js,src/services/credit-rates.js,src/services/credit-simulator.js,src/services/listing-quality.js}",
      "maxDuration": 15
    },
    "api/annonce.js": {
      "includeFiles": "{public/market-data/fr/**,src/services/seo-page-generator.js,src/services/acquisition-costs.js,src/services/credit-rates.js,src/services/credit-simulator.js,src/services/listing-quality.js}",
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cron-daily",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/feed-sync",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/feed-sync",
      "schedule": "45 3 * * *"
    }
  ]
}
