{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "B=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^};[ $B = $VERCEL_GIT_COMMIT_SHA ]&&exit 1;git cat-file -e $B^{commit}||exit 1;git diff --quiet $B -- ':/apps/find/apps/zfind-partner/**' ':/apps/find/apps/zfind-web/src/**' ':/apps/find/package.json' ':/package-lock.json'",
  "buildCommand": "cd ../.. && node apps/zfind-partner/scripts/build.js && mkdir -p apps/zfind-partner/vercel-output && cp apps/zfind-partner/dist/z-find-partner.html apps/zfind-partner/vercel-output/index.html",
  "outputDirectory": "vercel-output",
  "installCommand": "cd ../../../.. && npm ci --workspace=apps/find",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
