{
  admin off
  persist_config off
  auto_https off
  log {
    format json
  }
  servers {
    trusted_proxies static private_ranges 100.0.0.0/8
  }
}

:{$PORT:3000} {
  log {
    format json
  }

  encode gzip

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  @health path /health
  respond @health "ok" 200

  # Pages (FR/EN on the same page, French by default).
  @candidats path /candidats
  rewrite @candidats /candidats.html

  @employeurs path /employeurs
  rewrite @employeurs /employeurs.html

  @outils path /outils
  rewrite @outils /outils.html

  # Former Portuguese addresses.
  redir /candidatos /candidats 301
  redir /candidatos.html /candidats 301
  redir /empregadores /employeurs 301
  redir /empregadores.html /employeurs 301
  redir /ferramentas /outils 301
  redir /ferramentas.html /outils 301

  root * /srv
  file_server
}
