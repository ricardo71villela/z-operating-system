{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://z-jobs-api-zoperatingsystem.vercel.app/:path*"
    },
    {
      "source": "/offres/:slug",
      "destination": "https://z-jobs-api-zoperatingsystem.vercel.app/public/offres/:slug"
    },
    {
      "source": "/sitemap-offres.xml",
      "destination": "https://z-jobs-api-zoperatingsystem.vercel.app/public/sitemap-offres.xml"
    },
    {
      "source": "/emploi/:slug",
      "destination": "https://z-jobs-api-zoperatingsystem.vercel.app/public/emploi/:slug"
    },
    {
      "source": "/sitemap-emploi.xml",
      "destination": "https://z-jobs-api-zoperatingsystem.vercel.app/public/sitemap-emploi.xml"
    },
    {
      "source": "/entreprise/:slug",
      "destination": "https://z-jobs-api-zoperatingsystem.vercel.app/public/entreprise/:slug"
    },
    {
      "source": "/sitemap-entreprises.xml",
      "destination": "https://z-jobs-api-zoperatingsystem.vercel.app/public/sitemap-entreprises.xml"
    },
    {
      "source": "/salaire-brut-net",
      "destination": "https://z-jobs-api-zoperatingsystem.vercel.app/public/salaire/france"
    },
    {
      "source": "/salaire-brut-net/:amount",
      "destination": "https://z-jobs-api-zoperatingsystem.vercel.app/public/salaire/france/:amount"
    },
    {
      "source": "/salaire-brut-net-belgique",
      "destination": "https://z-jobs-api-zoperatingsystem.vercel.app/public/salaire/belgique"
    },
    {
      "source": "/salaire-brut-net-luxembourg",
      "destination": "https://z-jobs-api-zoperatingsystem.vercel.app/public/salaire/luxembourg"
    },
    {
      "source": "/en/gross-to-net-salary-france",
      "destination": "https://z-jobs-api-zoperatingsystem.vercel.app/public/salaire/france?lang=en"
    },
    {
      "source": "/en/gross-to-net-salary-belgium",
      "destination": "https://z-jobs-api-zoperatingsystem.vercel.app/public/salaire/belgique?lang=en"
    },
    {
      "source": "/en/gross-to-net-salary-luxembourg",
      "destination": "https://z-jobs-api-zoperatingsystem.vercel.app/public/salaire/luxembourg?lang=en"
    },
    {
      "source": "/sitemap-salaires.xml",
      "destination": "https://z-jobs-api-zoperatingsystem.vercel.app/public/sitemap-salaires.xml"
    },
    {
      "source": "/candidats",
      "destination": "/candidats.html"
    },
    {
      "source": "/employeurs",
      "destination": "/employeurs.html"
    },
    {
      "source": "/outils",
      "destination": "/outils.html"
    },
    {
      "source": "/entreprise",
      "destination": "/entreprise.html"
    },
    {
      "source": "/mentions-legales",
      "destination": "/mentions-legales.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/candidats",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/en/candidats",
      "permanent": true
    },
    {
      "source": "/employeurs",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/en/employeurs",
      "permanent": true
    },
    {
      "source": "/outils",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/en/outils",
      "permanent": true
    },
    {
      "source": "/mentions-legales",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "en"
        }
      ],
      "destination": "/en/mentions-legales",
      "permanent": true
    },
    {
      "source": "/candidatos",
      "destination": "/candidats",
      "permanent": true
    },
    {
      "source": "/candidatos.html",
      "destination": "/candidats",
      "permanent": true
    },
    {
      "source": "/empregadores",
      "destination": "/employeurs",
      "permanent": true
    },
    {
      "source": "/empregadores.html",
      "destination": "/employeurs",
      "permanent": true
    },
    {
      "source": "/ferramentas",
      "destination": "/outils",
      "permanent": true
    },
    {
      "source": "/ferramentas.html",
      "destination": "/outils",
      "permanent": true
    }
  ]
}
