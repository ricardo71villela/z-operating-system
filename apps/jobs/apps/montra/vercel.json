{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://z-jobs-api-zoperatingsystem.vercel.app/:path*"
    },
    {
      "source": "/candidats",
      "destination": "/candidats.html"
    },
    {
      "source": "/employeurs",
      "destination": "/employeurs.html"
    },
    {
      "source": "/outils",
      "destination": "/outils.html"
    },
    {
      "source": "/entreprise",
      "destination": "/entreprise.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/candidatos",
      "destination": "/candidats",
      "permanent": true
    },
    {
      "source": "/candidatos.html",
      "destination": "/candidats",
      "permanent": true
    },
    {
      "source": "/empregadores",
      "destination": "/employeurs",
      "permanent": true
    },
    {
      "source": "/empregadores.html",
      "destination": "/employeurs",
      "permanent": true
    },
    {
      "source": "/ferramentas",
      "destination": "/outils",
      "permanent": true
    },
    {
      "source": "/ferramentas.html",
      "destination": "/outils",
      "permanent": true
    }
  ]
}
