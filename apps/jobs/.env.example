# .env.example — Z Jobs
#
# Copia para .env e preenche com valores reais. Sem estas variáveis, a
# aplicação continua a funcionar em modo local/desenvolvimento — ver
# docs/POSTGRES-INTEGRATION.md, secção "Autenticação: caminho duplo".

# --- Base de dados ---
# String de ligação ao Postgres. Em produção, a do teu projeto Supabase
# (Project Settings -> Database -> Connection string, modo "Session").
DATABASE_URL=postgresql://zjobs_app:senha@127.0.0.1:5432/zjobs

# Tamanho do pool de ligações. Já não precisa de estar preso a 1 — ver
# a correção da causa raiz documentada em POSTGRES-INTEGRATION.md.
PG_POOL_MAX=10

# TLS da ligação PostgreSQL.
# Em produção Supabase usar: verify-full
# Quando ativo, a API usa o CA oficial incluído em apps/api/certs/.
# Não adicionar ?sslmode=... à DATABASE_URL neste modo.
JOBS_DB_SSL_MODE=

# --- Supabase Auth ---
# As três têm de estar TODAS presentes para a aplicação usar o
# Supabase Auth real; se faltar alguma, cai para a autenticação local
# de desenvolvimento (scrypt + tabela de sessões própria).
#
# Supabase Auth / ZOS shared database
#
# Preferir as novas API keys:
# - SUPABASE_PUBLISHABLE_KEY: chave pública, segura para operações Auth públicas
# - SUPABASE_SECRET_KEY: chave privada exclusivamente server-side
#
# Os nomes legacy SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY
# continuam aceites temporariamente pelo runtime para compatibilidade.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Access tokens are verified with the project's signing keys/JWKS
# through @supabase/supabase-js. No legacy JWT shared secret is required.

# Legacy compatibility only
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (email) ---
# Sem isto, os emails continuam só a ser registados na consola
# (ConsoleEmailService), nunca entregues — ver emailService.ts.
RESEND_API_KEY=
RESEND_FROM_EMAIL=nao-responder@zjobs.pt

# --- Porta do servidor ---
PORT=4000

# Shared ZOS database: use the dedicated Jobs schema instead of public.
# When set to jobs, Supabase Auth configuration above is mandatory.
JOBS_DB_SCHEMA=
