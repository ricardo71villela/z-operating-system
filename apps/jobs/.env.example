# .env.example — Z Jobs
#
# Copia para .env e preenche com valores reais. Sem estas variáveis, a
# aplicação continua a funcionar em modo local/desenvolvimento — ver
# docs/POSTGRES-INTEGRATION.md, secção "Autenticação: caminho duplo".

# --- Base de dados ---
# String de ligação ao Postgres. Em produção, a do teu projeto Supabase
# (Project Settings -> Database -> Connection string, modo "Session").
DATABASE_URL=postgresql://zjobs_app:senha@127.0.0.1:5432/zjobs

# Tamanho do pool de ligações. Já não precisa de estar preso a 1 — ver
# a correção da causa raiz documentada em POSTGRES-INTEGRATION.md.
PG_POOL_MAX=10

# --- Supabase Auth ---
# As três têm de estar TODAS presentes para a aplicação usar o
# Supabase Auth real; se faltar alguma, cai para a autenticação local
# de desenvolvimento (scrypt + tabela de sessões própria).
#
# SUPABASE_URL: Project Settings -> API -> Project URL
# SUPABASE_ANON_KEY: Project Settings -> API -> anon/public key
# SUPABASE_JWT_SECRET: Project Settings -> API -> JWT Secret
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- Resend (email) ---
# Sem isto, os emails continuam só a ser registados na consola
# (ConsoleEmailService), nunca entregues — ver emailService.ts.
RESEND_API_KEY=
RESEND_FROM_EMAIL=nao-responder@zjobs.pt

# --- Porta do servidor ---
PORT=4000
