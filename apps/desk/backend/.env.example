PORT=3001
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=redis://localhost:6379
DESK_BACKEND_PUBLIC_URL=http://localhost:3001
DESK_FRONTEND_PUBLIC_URL=http://localhost:3000

# D3 integration security. Server-only secrets; never expose through NEXT_PUBLIC_*.
DESK_OAUTH_STATE_SECRET=
# Base64 encoding of exactly 32 random bytes (AES-256-GCM key).
DESK_INTEGRATION_CREDENTIAL_KEY=
DESK_INTEGRATION_CREDENTIAL_KEY_VERSION=1

# Provider OAuth clients (server-only)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# AI triage is opt-in per workspace and remains human-in-loop.
AI_GATEWAY_API_KEY=
DESK_AI_MODEL=anthropic/claude-3-haiku

# Provider runtime remains opt-in until live provider gates are explicitly authorised.
DESK_ENABLE_WORKERS=false
DESK_EXTERNAL_CALENDAR_PUSH_ENABLED=false
DESK_WHATSAPP_EXPORT_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
